// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];

    PARTS:
    // Increment the current value
    Inc16(in=regOut, out=incOut);

    // Priority chain (lowest to highest): inc -> load -> reset
    Mux16(a=regOut, b=incOut, sel=inc,   out=afterInc);
    Mux16(a=afterInc, b=in,   sel=load,  out=afterLoad);
    Mux16(a=afterLoad, b=false, sel=reset, out=afterReset);

    // Register always loads the selected value (hold case is handled by the muxes)
    Register(in=afterReset, load=true, out=regOut, out=out);
}