/**
 * ALU (Arithmetic Logic Unit):
 * Computes out = one of the following functions:
 *   0, 1, -1, x, y, !x, !y, -x, -y, x+1, y+1, x-1, y-1, x+y, x-y, y-x, x&y, x|y
 * on the 16-bit inputs x, y, according to the 6 input bits zx, nx, zy, ny, f, no.
 * In addition, computes the two output bits:
 *   if (out == 0) zr = 1, else zr = 0
 *   if (out < 0)  ng = 1, else ng = 0
 */
CHIP ALU {
    IN
        x[16], y[16],
        zx, nx, zy, ny, f, no;
    OUT
        out[16],
        zr, ng;

    PARTS:
    // Zero and negate x
    Mux16(a=x, b=false, sel=zx, out=xZero);
    Not16(in=xZero, out=notX);
    Mux16(a=xZero, b=notX, sel=nx, out=xVal);

    // Zero and negate y
    Mux16(a=y, b=false, sel=zy, out=yZero);
    Not16(in=yZero, out=notY);
    Mux16(a=yZero, b=notY, sel=ny, out=yVal);

    // Compute x + y or x & y
    Add16(a=xVal, b=yVal, out=addXY);
    And16(a=xVal, b=yVal, out=andXY);
    Mux16(a=andXY, b=addXY, sel=f, out=fOut);

    // Optionally negate output and extract status bits
    Not16(in=fOut, out=notFOut);
    Mux16(a=fOut, b=notFOut, sel=no, out=out, out[0..7]=lowByte, out[8..15]=highByte, out[15]=ng);

    Or8Way(in=lowByte, out=orLow);
    Or8Way(in=highByte, out=orHigh);
    Or(a=orLow, b=orHigh, out=nonZero);
    Not(in=nonZero, out=zr);
}
